# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.pytest_cache/
.mypy_cache/

# macOS
.DS_Store

# Game files and working data, never commit these
data/*
!data/.gitkeep
work/
work-*/
work_*/
out/*
!out/.gitkeep
*.pdf

# Secrets (dotenvx). .env.keys holds the private key, never commit any of these
.env
.env.*
!.env.example
